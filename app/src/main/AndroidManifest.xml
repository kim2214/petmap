<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 11+ 패키지 가시성: 전화/공유/브라우저/네이버지도 인텐트 -->
    <queries>
        <package android:name="com.nhn.android.nmap" />
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".PetMapApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PetMap">

        <!-- AdMob 앱 ID (app/build.gradle.kts 의 빌드 타입별 manifestPlaceholders 에서 주입 — 디버그는 테스트 ID). 없으면 앱 시작 시 크래시함. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- 네이버 지도 Client ID. 값은 local.properties 의 naver.map.clientId 에서 주입됨.
             구버전 SDK는 com.naver.maps.map.CLIENT_ID 를 사용하므로 SDK 버전에 맞게 키 이름을 조정하세요. -->
        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="${naverMapClientId}" />

        <!-- singleTask: 딥링크로 열릴 때 새 인스턴스가 쌓이지 않고 onNewIntent 로 전달된다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PetMap.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 공유 링크로 장소 상세 진입 (HTTPS App Link): https://kim2214.github.io/petmap/place?id={placeId}
                 autoVerify: 설치 시 https://kim2214.github.io/.well-known/assetlinks.json 의 서명 지문과
                 대조해 통과하면 브라우저 선택 없이 앱이 바로 열린다. 지문에는 Play 앱 서명 키가 포함돼야 한다. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="kim2214.github.io"
                    android:pathPrefix="/petmap/place" />
            </intent-filter>
            <!-- 구버전 공유 링크(커스텀 스킴) 호환: petmap://place/{placeId} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="petmap" android:host="place" />
            </intent-filter>
        </activity>
    </application>

</manifest>
